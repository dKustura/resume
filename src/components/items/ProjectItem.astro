---
import { ExternalLink, TechPills } from '../ui'
import type { ProjectEntry } from '../../data'
import { filterableClass } from './filterable'

type Props = ProjectEntry

const { title, description, period, tech = [], link } = Astro.props
---

<article data-filterable class={filterableClass}>
  <div class="px-5 py-7 sm:px-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <h3 class="font-medium text-neutral-900 dark:text-neutral-100">
        {
          link && (
            <ExternalLink
              href={link}
              text={title}
              class="transition-colors hover:text-emerald-600 dark:hover:text-emerald-400"
            />
          )
        }
        {!link && title}
      </h3>
      <p class="mt-1 shrink-0 font-mono text-sm text-neutral-500 tabular-nums dark:text-neutral-400">
        {period}
      </p>
    </div>

    {
      description && (
        <p class="mt-2 text-sm leading-relaxed text-pretty text-neutral-500 dark:text-neutral-400">
          {description}
        </p>
      )
    }

    <TechPills tech={tech} class="mt-4" />
  </div>
</article>
