---
import { TechPills } from '../ui'

type Props = {
  tech?: string[]
  bullets?: string[]
}

const { tech = [], bullets = [] } = Astro.props
---

<TechPills tech={tech} class="mt-4" />

{
  bullets.length > 0 && (
    <ul class="mt-4 space-y-1.5">
      {bullets.map((bullet) => (
        <li class="relative pl-3 text-sm leading-relaxed text-pretty text-neutral-600 before:absolute before:left-0 before:text-neutral-300 before:content-['–'] dark:text-neutral-400 dark:before:text-neutral-600">
          {bullet}
        </li>
      ))}
    </ul>
  )
}
