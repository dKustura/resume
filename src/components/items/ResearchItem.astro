---
import { ExternalLink, TechPills } from '../ui'
import type { ResearchEntry } from '../../data'
import { filterableClass } from './filterable'

type Props = ResearchEntry

const { title, link, subtitle, description, period, tech = [] } = Astro.props
---

<article data-filterable class={filterableClass}>
  <div class="px-5 py-7 sm:px-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h3 class="font-medium text-pretty text-neutral-900 dark:text-neutral-100">
          <ExternalLink
            href={link}
            text={title}
            class="transition-colors hover:text-emerald-600 dark:hover:text-emerald-400"
          />
        </h3>
        {
          subtitle && (
            <p class="mt-0.5 text-xs text-neutral-400 dark:text-neutral-500">{subtitle}</p>
          )
        }
      </div>
      <p class="mt-1 shrink-0 font-mono text-sm text-neutral-500 tabular-nums dark:text-neutral-400">
        {period}
      </p>
    </div>
    {
      description && (
        <p class="mt-3 text-sm leading-relaxed text-pretty text-neutral-500 dark:text-neutral-400">
          {description}
        </p>
      )
    }
    <TechPills tech={tech} class="mt-4" />
  </div>
</article>
