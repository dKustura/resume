---
import { CompanyIcon, ExternalIcon } from '../ui'
import type { ExperienceEntry } from '../../data'
import RoleDetails from './RoleDetails.astro'
import { filterableClass } from './filterable'

type Props = ExperienceEntry

const { company, companyUrl, iconType, note, roles } = Astro.props

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']

// "Sep 2022" → months since year 0; "Present" is the build month
const toMonthIndex = (text: string) => {
  if (text === 'Present') {
    const now = new Date()
    return now.getFullYear() * 12 + now.getMonth()
  }
  const [month, year] = text.split(' ')
  return Number(year) * 12 + MONTHS.indexOf(month)
}

const plural = (n: number, unit: string) => `${n} ${unit}${n === 1 ? '' : 's'}`

// LinkedIn-style duration ("4 yrs 2 mos"), counting both end months
const formatDuration = (from: string, to: string) => {
  const total = toMonthIndex(to) - toMonthIndex(from) + 1
  const years = Math.floor(total / 12)
  const months = total % 12
  return [years && plural(years, 'yr'), months && plural(months, 'mo')]
    .filter(Boolean)
    .join(' ')
}

const isGrouped = roles.length > 1
const start = roles[roles.length - 1].period.split(' – ')[0]
const end = roles[0].period.split(' – ')[1]
const companyPeriod = `${start} – ${end}`
const isCurrent = end === 'Present'
---

<article data-filterable class={filterableClass}>
  <div class="px-5 py-7 sm:px-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        {
          !isGrouped && (
            <h3 class="font-medium text-emerald-600 dark:text-emerald-400">{roles[0].role}</h3>
          )
        }
        <a
          href={companyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'group inline-flex items-center gap-1.5 transition-colors',
            {
              'font-medium text-neutral-900 hover:text-emerald-600 dark:text-neutral-100 dark:hover:text-emerald-400':
                isGrouped,
              'mt-0.5 text-sm text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100':
                !isGrouped,
            },
          ]}
        >
          <CompanyIcon type={iconType} class:list={['shrink-0', { 'size-4': isGrouped, 'size-3.5': !isGrouped }]} />
          {company}
          {note && <span class="text-neutral-400 dark:text-neutral-500">· {note}</span>}
          <ExternalIcon />
        </a>
      </div>
      <p class="mt-1 shrink-0 text-right font-mono text-sm text-neutral-500 tabular-nums dark:text-neutral-400">
        {
          isCurrent && (
            <span aria-hidden="true" class="relative mr-2 inline-block size-1.5 -translate-y-0.5 align-middle">
              <span class="absolute inset-0 rounded-full bg-emerald-500 motion-safe:animate-live-ping dark:bg-emerald-400" />
              <span class="absolute inset-0 rounded-full bg-emerald-500 dark:bg-emerald-400" />
            </span>
          )
        }
        {companyPeriod}
        <span class="block text-xs text-neutral-400 dark:text-neutral-500">
          {formatDuration(start, end)}
        </span>
      </p>
    </div>

    {
      isGrouped && (
        <ol class="mt-6 space-y-7">
          {roles.map((role, index) => (
            <li data-filterable class:list={['relative pl-7', filterableClass]}>
              {index < roles.length - 1 && (
                <span
                  aria-hidden="true"
                  class="absolute top-4 -bottom-7 left-[5px] w-px bg-neutral-200 dark:bg-neutral-800"
                />
              )}
              <span
                aria-hidden="true"
                class:list={[
                  'absolute top-1.5 left-0 size-[11px] rounded-full border-2',
                  {
                    'border-emerald-500 bg-emerald-500 dark:border-emerald-400 dark:bg-emerald-400':
                      index === 0 && isCurrent,
                    'border-neutral-300 bg-bg-light dark:border-neutral-600 dark:bg-bg-dark': index > 0 || !isCurrent,
                  },
                ]}
              />
              <div class="flex flex-wrap items-start justify-between gap-4">
                <h3 class="font-medium text-emerald-600 dark:text-emerald-400">{role.role}</h3>
                <p class="mt-1 shrink-0 font-mono text-xs text-neutral-500 tabular-nums dark:text-neutral-400">
                  {role.period}
                </p>
              </div>
              <RoleDetails tech={role.tech} bullets={role.bullets} />
            </li>
          ))}
        </ol>
      )
    }

    {!isGrouped && <RoleDetails tech={roles[0].tech} bullets={roles[0].bullets} />}
  </div>
</article>
