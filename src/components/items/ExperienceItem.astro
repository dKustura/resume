---
import { CompanyIcon } from '../ui';
import type { ExperienceEntry } from '../../data';
import RoleDetails from './RoleDetails.astro';

type Props = ExperienceEntry;

const { company, companyUrl, iconType, note, roles } = Astro.props;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// "Sep 2022" → months since year 0; "Present" is the build month
const toMonthIndex = (text: string) => {
  if (text === 'Present') {
    const now = new Date();
    return now.getFullYear() * 12 + now.getMonth();
  }
  const [month, year] = text.split(' ');
  return Number(year) * 12 + MONTHS.indexOf(month);
};

const plural = (n: number, unit: string) => `${n} ${unit}${n === 1 ? '' : 's'}`;

// LinkedIn-style duration ("4 yrs 2 mos"), counting both end months
const formatDuration = (from: string, to: string) => {
  const total = toMonthIndex(to) - toMonthIndex(from) + 1;
  const years = Math.floor(total / 12);
  const months = total % 12;
  return [years && plural(years, 'yr'), months && plural(months, 'mo')]
    .filter(Boolean)
    .join(' ');
};

const isGrouped = roles.length > 1;
const start = roles[roles.length - 1].period.split(' – ')[0];
const end = roles[0].period.split(' – ')[1];
const companyPeriod = `${start} – ${end}`;
const isCurrent = end === 'Present';
---

<article>
  <div class="px-8 py-7">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        {
          !isGrouped && (
            <h3 class="font-medium text-emerald-600 dark:text-emerald-400">
              {roles[0].role}
            </h3>
          )
        }
        <a
          href={companyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'inline-flex items-center gap-1.5 transition-colors',
            isGrouped
              ? 'font-medium text-neutral-900 dark:text-neutral-100 hover:text-emerald-600 dark:hover:text-emerald-400'
              : 'text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 mt-0.5',
          ]}
        >
          <CompanyIcon
            type={iconType}
            class:list={['shrink-0', isGrouped ? 'w-4 h-4' : 'w-3.5 h-3.5']}
          />
          {company}
          {
            note && (
              <span class="text-neutral-400 dark:text-neutral-500">
                {' '}
                · {note}
              </span>
            )
          }
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="10"
            height="10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="opacity-40 -mb-px"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
            ></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>
      <p
        class="text-sm font-mono text-neutral-500 dark:text-neutral-400 mt-1 shrink-0 tabular-nums text-right"
      >
        {companyPeriod}
        {
          isGrouped && (
            <span class="block text-xs text-neutral-400 dark:text-neutral-500">
              {formatDuration(start, end)}
            </span>
          )
        }
      </p>
    </div>

    {
      isGrouped ? (
        <ol class="mt-6 space-y-7">
          {roles.map((r, i) => (
            <li class="relative pl-7">
              {i < roles.length - 1 && (
                <span
                  aria-hidden="true"
                  class="absolute left-[5px] top-4 -bottom-7 w-px bg-neutral-200 dark:bg-neutral-800"
                />
              )}
              <span
                aria-hidden="true"
                class:list={[
                  'absolute left-0 top-1.5 w-[11px] h-[11px] rounded-full border-2',
                  i === 0 && isCurrent
                    ? 'bg-emerald-500 border-emerald-500 dark:bg-emerald-400 dark:border-emerald-400'
                    : 'bg-bg-light dark:bg-bg-dark border-neutral-300 dark:border-neutral-600',
                ]}
              />
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <h3 class="font-medium text-emerald-600 dark:text-emerald-400">
                  {r.role}
                </h3>
                <p class="text-xs font-mono text-neutral-500 dark:text-neutral-400 mt-1 shrink-0 tabular-nums">
                  {r.period}
                </p>
              </div>
              <RoleDetails tech={r.tech} bullets={r.bullets} />
            </li>
          ))}
        </ol>
      ) : (
        <RoleDetails tech={roles[0].tech} bullets={roles[0].bullets} />
      )
    }
  </div>
</article>
