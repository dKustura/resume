---
import TechPill from './TechPill.astro'

type Props = {
  tech: string[]
  class?: string
}

const { tech, class: className } = Astro.props
---

{
  tech.length > 0 && (
    <ul class:list={['flex flex-wrap gap-1.5', className]}>
      {tech.map((name) => (
        <TechPill name={name} as="li" size="sm" />
      ))}
    </ul>
  )
}
