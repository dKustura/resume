---
import { techByName } from '../../data'
import TechIcon from './TechIcon.astro'

type Props = {
  name: string
  /** button: toggles the tech filter · li: inside an entry's list · span: static */
  as?: 'button' | 'li' | 'span'
  /** sm: compact pill inside entries · md: bordered pill in the Technologies list */
  size?: 'sm' | 'md'
}

const { name, as: Element = 'span', size = 'md' } = Astro.props

const icon = techByName.get(name)?.icon
const isButton = Element === 'button'
---

<Element
  type={isButton ? 'button' : undefined}
  aria-pressed={isButton ? 'false' : undefined}
  data-tech={name}
  data-tech-filter={isButton ? '' : undefined}
  class:list={[
    'group inline-flex items-center gap-1.5 rounded-md border text-xs text-neutral-600 transition-colors dark:text-neutral-400',
    'data-active:border-emerald-300 data-active:bg-emerald-100/60 data-active:text-emerald-700',
    'dark:data-active:border-emerald-500/50 dark:data-active:bg-emerald-900/40 dark:data-active:text-emerald-300',
    {
      'border-transparent bg-neutral-100/80 px-2 py-0.5 dark:bg-neutral-800/60': size === 'sm',
      'border-neutral-200 bg-neutral-100 px-3 py-1 dark:border-neutral-700 dark:bg-neutral-800/80': size === 'md',
      'cursor-pointer hover:border-emerald-400 hover:text-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500 dark:hover:border-emerald-500 dark:hover:text-emerald-400':
        isButton,
    },
  ]}
>
  {icon && <TechIcon slug={icon} />}
  {name}
</Element>
