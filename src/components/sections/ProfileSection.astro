---
import { Image } from 'astro:assets'
import { ResumeButton, SocialLinks } from '../ui'
import { personal } from '../../data'

type Props = {
  variant: 'mobile' | 'desktop'
}

const { variant } = Astro.props

const avatarClass =
  'shrink-0 rounded-full border border-neutral-200 bg-neutral-100 object-cover dark:border-neutral-700 dark:bg-neutral-800'
---

{
  variant === 'mobile' && (
    <div class="px-5 py-6 sm:px-8">
      <div class="flex items-center gap-4">
        <Image
          src={personal.avatar}
          alt={personal.name}
          width={64}
          height={64}
          fit="cover"
          densities={[1, 2, 3]}
          class:list={[avatarClass, 'size-16']}
        />
        <div class="min-w-0">
          <h1 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
            {personal.name}
          </h1>
          <p class="mt-0.5 text-sm text-emerald-600 dark:text-emerald-400">{personal.title}</p>
        </div>
      </div>
      <div class="mt-5 flex items-center gap-2">
        <SocialLinks variant="icon" />
        <ResumeButton data-resume-cta class="btn-pop flex-1" />
      </div>
    </div>
  )
}

{
  variant === 'desktop' && (
    <div class="space-y-5 px-8 py-8">
      <Image
        src={personal.avatar}
        alt={personal.name}
        width={160}
        height={160}
        fit="cover"
        densities={[1, 2]}
        class:list={[avatarClass, 'size-40']}
      />
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
          {personal.name}
        </h1>
        <p class="mt-1 text-sm text-emerald-600 dark:text-emerald-400">{personal.title}</p>
      </div>
      <SocialLinks />
      <ResumeButton data-resume-cta class="btn-pop w-full" />
    </div>
  )
}
