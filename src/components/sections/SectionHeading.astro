---
type Props = {
  eyebrow: string
  title: string
}

const { eyebrow, title } = Astro.props
---

<div class="px-5 py-8 sm:px-8">
  <p class="mb-1.5 text-xs font-medium tracking-widest text-emerald-600 uppercase dark:text-emerald-400">
    {eyebrow}
  </p>
  <h2 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
    {title}
  </h2>
</div>
