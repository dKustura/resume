---
import { personal } from '../../data'
---

<!-- The opening paragraph reads as the summary on its own; the heading is for screen readers -->
<section
  id="summary"
  aria-labelledby="summary-heading"
  class="border-b border-neutral-200 px-5 py-8 sm:px-8 sm:py-10 dark:border-neutral-800"
>
  <h2 id="summary-heading" class="sr-only">Summary</h2>
  <p class="max-w-prose text-base leading-relaxed text-pretty text-neutral-700 dark:text-neutral-300">
    {personal.summary}
  </p>
</section>
