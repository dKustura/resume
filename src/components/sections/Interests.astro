---
import { personal } from '../../data'

const { interests } = personal
---

<div class="space-y-3 px-5 py-8 sm:px-8">
  <p class="text-xs font-medium tracking-widest text-neutral-400 uppercase dark:text-neutral-500">
    Interests
  </p>
  <div class="flex flex-wrap gap-x-3 gap-y-1.5">
    {
      interests.map((item) =>
        typeof item === 'string' ? (
          <span class="text-xs text-neutral-500 dark:text-neutral-400">{item}</span>
        ) : (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-neutral-500 underline underline-offset-2 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            {item.label}
          </a>
        ),
      )
    }
  </div>
</div>
