---
import type { EducationEntry } from '../../data'

type Props = {
  items: EducationEntry[]
}

const { items } = Astro.props
---

<div class="space-y-4 px-5 py-8 sm:px-8">
  <p class="text-xs font-medium tracking-widest text-neutral-400 uppercase dark:text-neutral-500">
    Education
  </p>
  <div class="space-y-5">
    {
      items.map((item) => (
        <div>
          <p class="text-sm font-medium text-neutral-800 dark:text-neutral-200">{item.degree}</p>
          <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">{item.school}</p>
          <p class="mt-0.5 font-mono text-sm text-neutral-500 tabular-nums dark:text-neutral-400">
            {item.period}
          </p>
        </div>
      ))
    }
  </div>
</div>
