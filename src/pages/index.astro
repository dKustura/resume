---
import Layout from '../layouts/Layout.astro'
import { GutterStreak, Nav } from '../components/ui'
import { ExperienceItem, ProjectItem, ResearchItem } from '../components/items'
import {
  EducationSection,
  Interests,
  ProfileSection,
  SectionHeading,
  SummarySection,
  TechGrid,
} from '../components/sections'
import { education, experience, projects, research, techGroups } from '../data'
---

<Layout>
  <Nav />
  <GutterStreak />

  <!-- Solid background so the gutter animation only shows outside the column -->
  <div
    data-gutter-column
    class="mx-auto max-w-6xl border-x border-b border-neutral-200 bg-bg-light dark:border-neutral-800 dark:bg-bg-dark"
  >
    <!--
      Mobile (<md, flex-col):  order-1 profile → order-2 main → order-3 education/tech/interests
      Desktop (md+, grid):     col-1 main | col-2 sidebar, pinned once its bottom reaches the viewport
    -->
    <div class="flex flex-col md:grid md:grid-cols-[1fr_300px]">
      <aside class="order-1 border-b border-neutral-200 md:hidden dark:border-neutral-800">
        <ProfileSection variant="mobile" />
      </aside>

      <main
        class="order-2 border-neutral-200 md:col-start-1 md:row-start-1 md:border-r dark:border-neutral-800"
      >
        <SummarySection />

        <section
          id="experience"
          class="scroll-mt-14 divide-y divide-neutral-200 border-b border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800"
        >
          <SectionHeading eyebrow="Career" title="Work Experience" />
          {experience.map((item) => <ExperienceItem {...item} />)}
        </section>

        <section
          id="projects"
          class="scroll-mt-14 divide-y divide-neutral-200 border-b border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800"
        >
          <SectionHeading eyebrow="Other Work" title="Side Projects" />
          {projects.map((item) => <ProjectItem {...item} />)}
        </section>

        <section id="research" class="scroll-mt-14 divide-y divide-neutral-200 dark:divide-neutral-800">
          <SectionHeading eyebrow="Academic" title="Research" />
          {research.map((item) => <ResearchItem {...item} />)}
        </section>
      </main>

      <!-- Desktop sidebar: scrolls with the page until its bottom reaches the viewport, then stays pinned -->
      <aside class="hidden md:sticky md:bottom-0 md:col-start-2 md:row-start-1 md:block md:self-end">
        <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
          <ProfileSection variant="desktop" />
          <EducationSection items={education} />
          <TechGrid groups={techGroups} variant="filter" />
          <Interests />
        </div>
      </aside>

      <aside class="order-3 border-t border-neutral-200 md:hidden dark:border-neutral-800">
        <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
          <EducationSection items={education} />
          <TechGrid groups={techGroups} variant="collapsible" />
          <Interests />
        </div>
      </aside>
    </div>

    <footer class="border-t border-neutral-200 px-5 py-5 sm:px-8 dark:border-neutral-800">
      <p class="text-xs text-neutral-400 dark:text-neutral-600">
        Denis Kustura &copy; {new Date().getFullYear()}
      </p>
    </footer>
  </div>
</Layout>
