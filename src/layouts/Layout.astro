---
import { Font, getImage } from 'astro:assets'
import '../styles/global.css'
import { personal, experience } from '../data'

type Props = {
  title?: string
  description?: string
}

const {
  title = 'Denis Kustura - Senior Software Engineer',
  description = 'Senior Software Engineer specializing in Full-stack web development.',
} = Astro.props

const ogUrl = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL('/og-image.png', Astro.site).href
const avatarImage = await getImage({
  src: personal.avatar,
  width: 400,
  height: 400,
  fit: 'cover',
  format: 'jpeg',
})

// Structured data so search engines can show a person card
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: personal.name,
  jobTitle: personal.title,
  url: Astro.site?.href,
  image: new URL(avatarImage.src, Astro.site).href,
  sameAs: [personal.linkedin, personal.github],
  worksFor: {
    '@type': 'Organization',
    name: experience[0].company,
    url: experience[0].companyUrl,
  },
}
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth scheme-light dark:scheme-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Browser UI colour on mobile; the theme script below and ThemeToggle keep it in sync -->
    <meta name="theme-color" content="#fafafa" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Denis Kustura" />
    <link rel="canonical" href={ogUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Fonts: self-hosted by Astro (see `fonts` in astro.config.mjs) -->
    <Font cssVariable="--font-inter" preload={[{ subset: 'latin', weight: 400 }]} />
    <Font cssVariable="--font-geist-mono" />

    <!-- Dark mode: set before paint to prevent flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        const isDark = stored === 'dark' || (!stored && prefersDark)
        if (!isDark) return
        document.documentElement.classList.add('dark')
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#0a0a0a')
      })()
    </script>
  </head>
  <body
    class="selection:bg-emerald-200/70 selection:text-emerald-950 dark:selection:bg-emerald-400/25 dark:selection:text-emerald-50"
  >
    <slot />
  </body>
</html>
